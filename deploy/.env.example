# Production settings for deploy/compose.yaml: copy to deploy/.env and fill
# in. See docs/DEPLOYMENT.md. Plain KEY=value lines: no quotes, and no `$`
# in values (Compose would expand it).

# LAN and tailnet. For the LAN only, use just compose.yaml and leave
# TAILNET_ADDR out.
COMPOSE_FILE=compose.yaml:compose.tailnet.yaml

# PostgreSQL. Letters and digits only, since it goes into a URL, e.g. from
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# POSTGRES_USER=bucky
# POSTGRES_DB=bucky

# What you type in the browser, comma-separated: names, or IP addresses
# (docs/DEPLOYMENT.md, "Names or addresses"). The certificate must cover
# every one.
BUCKY_HOSTNAMES=bucky.home.example
# Where Caddy listens: the host's LAN address and, with the tailnet, its
# tailnet address (`tailscale ip -4`). Ports 80 and 443 are opened on these
# only. Keep the LAN address fixed (a DHCP reservation, or set on the host).
LAN_ADDR=192.168.1.10
TAILNET_ADDR=100.64.0.10

# The certificate (with any intermediates) and its key, PEM, in this folder.
TLS_CERT_DIR=/etc/bucky-budgetr/tls
TLS_CERT_FILE=cert.pem
TLS_KEY_FILE=key.pem

# The first admin's password, used on the very first start only. At least 12
# characters. You still choose a new one at first login.
BUCKY_INITIAL_ADMIN_PASSWORD=

# Backups (deploy/backup.sh): a folder outside Docker, owned by the user with
# these IDs (`id -u`, `id -g`).
BACKUP_DIR=/srv/bucky-budgetr/backups
BACKUP_UID=1000
BACKUP_GID=1000
# A daily backup after this time, in the TZ time zone.
BACKUP_TIME=03:00
TZ=Europe/Oslo
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Optional (defaults shown)
# LOG_LEVEL=info
# SESSION_IDLE_TIMEOUT=168h
# SESSION_MAX_AGE=720h
# SCHEDULE_INTERVAL=30s
