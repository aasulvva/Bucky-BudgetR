# Local dev settings. `make` copies this to .env on first run; .env is gitignored.
# Read by both Docker Compose and the Makefile, so keep it to plain KEY=value lines
# (no quotes, spaces, `$` or `#` in values).

# PostgreSQL (compose.yaml)
POSTGRES_USER=bucky
POSTGRES_PASSWORD=bucky
POSTGRES_DB=bucky
POSTGRES_PORT=5432

# Built from the values above by the Makefile. Set it here to override.
# DATABASE_URL=postgres://bucky:bucky@localhost:5432/bucky?sslmode=disable

# Backend API (see docs/DEVELOPMENT.md for all settings) and Vite dev server
APP_ENV=development
LOG_LEVEL=debug
API_HOST=127.0.0.1
API_PORT=8080
WEB_PORT=5173

# Sessions and the first admin account (defaults shown; see docs/DEVELOPMENT.md)
# SESSION_IDLE_TIMEOUT=168h
# SESSION_MAX_AGE=720h
# BUCKY_INITIAL_ADMIN_PASSWORD=

# Report PDFs (#127): run `docker compose --profile pdf up -d chrome`, then
# uncomment these three (see docs/DEVELOPMENT.md). Chrome reaches Vite
# through the Docker bridge, so Vite listens on every interface.
# PDF_CHROME_URL=http://127.0.0.1:9222
# PDF_APP_URL=http://host.docker.internal:5173
# VITE_HOST=0.0.0.0
